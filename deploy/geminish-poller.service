# geminish poller for Linux (systemd user unit).
#   cp geminish-poller.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now geminish-poller.service
# Needs lingering for the user (loginctl enable-linger) to run without a login session.
[Unit]
Description=geminish poller (geminise mailbox reader for this Hermes agent)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/.hermes/plugins/geminish/cli.py poll
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_HOME=%h/.hermes
WorkingDirectory=%h/.hermes
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
